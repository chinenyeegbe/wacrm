# Local Worker secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to `.dev.vars` (gitignored) and fill in. In production these are
# set with `wrangler secret put <NAME>` — NOT committed here.
#
# Mirrors .env.local.example; see that file for what each value is.

# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=your-64-char-hex-key-here
META_APP_SECRET=your-meta-app-secret

# Recommended
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Optional — only if you use automation Wait-steps / flow timers
# AUTOMATION_CRON_SECRET=generate-a-long-random-string
